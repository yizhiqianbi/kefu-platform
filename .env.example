# 复制成 .env 后按部署环境修改。也可以直接用同名环境变量。

# 数据目录和数据库。不填 DATABASE_URL 时用数据目录下的 SQLite；正式环境建议 PostgreSQL：
#   DATABASE_URL=postgresql+psycopg://muxu:密码@db:5432/muxu
MUXU_DATA_DIR=/var/lib/muxu
# DATABASE_URL=

# RAGFlow：接口地址和 API Key（在 RAGFlow 里用服务账号创建）
RAGFLOW_URL=http://ragflow:9380/api/v1
RAGFLOW_API_KEY_FILE=/run/secrets/ragflow_api_key
# 开新客户时用哪个对话模型和向量模型（填 RAGFlow 里的模型名），不填就用第一个
# RAGFLOW_CHAT_MODEL=deepseek-chat
# RAGFLOW_EMBED_MODEL=text-embedding-v3

# 自动评分、AI 起草、生成测试题用的模型：任何兼容 OpenAI 接口的渠道都可以
#   DeepSeek：https://api.deepseek.com/v1         模型 deepseek-chat
#   阿里百炼：https://dashscope.aliyuncs.com/compatible-mode/v1   模型 qwen-plus
#   火山方舟：https://ark.cn-beijing.volces.com/api/v3            模型 填接入点 ID
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY_FILE=/run/secrets/llm_api_key
JUDGE_MODEL=deepseek-chat
# 社媒和邮件消息的意图判断用决策模型 Jev，只有 OpenRouter 有（LLM_BASE_URL=https://openrouter.ai/api/v1）。
# 用别的渠道时 Jev 调不通，会自动改用 JUDGE_MODEL 判断，慢一些、贵一些。
ROUTER_MODEL=typesafe/jev-1.13
# 回复 agent 用的模型。一条消息要调 2 到 4 次，用快的；填空就用 JUDGE_MODEL
AGENT_MODEL=deepseek/deepseek-v4.1-flash

# 访问 /muxu/ 时默认打开哪个客户的咨询页
DEFAULT_TENANT=muxu
SESSION_DAYS=7
UPLOAD_MAX_MB=30

# 达人自动运营多少秒跑一轮；0 是关掉定时调度，只能在运营台手动「立即运行一次」
PILOT_INTERVAL=120

# Chatwoot 渠道层（WhatsApp、Instagram、Messenger、邮件、Telegram…），不用就留空。见 docs/chatwoot-integration.md
# CHATWOOT_URL：本服务访问 Chatwoot 的地址；CHATWOOT_PUBLIC_URL：浏览器访问的地址，必须和运营台同站（同主域名），收件箱才能嵌进运营台。
CHATWOOT_URL=
CHATWOOT_PUBLIC_URL=
CHATWOOT_PLATFORM_TOKEN_FILE=/run/secrets/chatwoot_platform_token
# Chatwoot 回调本服务的地址（同机部署填内网地址，Chatwoot 那边要设 SAFE_FETCH_ALLOW_PRIVATE_NETWORK=true）
MUXU_PUBLIC_URL=http://127.0.0.1:8770
# 客户连发几条消息时，等多少秒再合并回答
CHATWOOT_DEBOUNCE=3

# 个人号（Telegram / WhatsApp / Instagram）连平台用的代理；不填就用本机的 HTTPS_PROXY，海外服务器上留空直连
PERSONAL_PROXY=
# 外部平台（企业微信）回调本服务的公网地址，如 https://kefu.example.com；不填就定时拉消息
CALLBACK_BASE_URL=
